# P generation vcf, so easy to score genotype data
df.2021_N.gt.dp.data <- df.2021_N.initial.data %>% 
    mutate(genotype_score = if_else(sstrain == "WLI", (rowSums(.[11:13] == '1/1') + rowSums(.[14:16] == '0/0')), (rowSums(.[11:13] == '0/0') + rowSums(.[14:16] == '1/1')))) %>%
    # select(-(ends_with("DP") & contains("chromium"))) %>% 
    mutate(depth_ave = rowMeans(.[17:22])) %>% 
    mutate(depth_med = rowMedians(as.matrix(.[17:22]))) %>% 
    mutate(depth_score = rowSums(.[17:22] > rowMedians(as.matrix(.[17:22])))) %>% 
    arrange(desc(genotype_score), desc(depth_ave)) %>% 
    # select(sstrain, ends_with("GT"), genotype_score) %>% 
    view()
