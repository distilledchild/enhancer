# 149// 224 markers
# merged bam file project = 224 = 300 - (6 SNPs in autosome) c.f. 5 Y markers are in 224 (545중에서 230개 snps가 원본 > 224개 건짐 from merged data)
df.2nd.try.data <- read.csv(file.path(root.dir, oxy.project.l.dir, "rccWmiwli2021LGTDPData_2nd_try.csv"), header=T, encoding = 'utf-8') %>% 
                            separate(CHROM, into=c("q", "strain", "vt", "Chr", "Start", "End"), sep = '[|-]', remove=FALSE) %>% 
                            filter(genotype_flag == "Polymorphic" & depth_flag == "Valid") %>% # picked condition
                            mutate(Start = as.numeric(Start), End = as.numeric(End)) %>% 
                            arrange(Chr, Start) %>% 
                            view()
# count(genotype_flag, depth_flag) %>% # polymorphic, valid: 149

# label for 149 markes picked
df.2nd.try.lable.data <- df.2nd.try.data %>% 
                            mutate(Type = strain) %>% 
                            mutate(Shape = "circle") %>% 
                            mutate(color = "0") %>% 
                            mutate(Shape, Shape = if_else(strain == "WLI", "triangle", Shape)) %>% 
                            mutate(color, color = if_else(strain == "WLI", "6a3d9a", "33a02c")) %>% 
                            select(Type, Shape, Chr, Start, End, color) %>% 
                            mutate_at(c(4:5), as.numeric) %>% 
                            view()
# filter(starwars, between(height, 100, 150))

# density data
df.2nd.try.coord.data <- df.2nd.try.data %>% 
                            group_by(Chr) %>% 
                            summarise(min_val = min(Start), max_val = max(End)) %>% # min_val: marker min, max_val: marker max
                            ungroup() %>% 
                            inner_join(df.2nd.try.lable.data, by="Chr") %>% 
                            select(-c(Type, Shape, color)) %>% 
                            inner_join(rn6.ref %>% rename(Terminal = End) %>% rename(Init = Start) %>%  mutate(Init = Init + 1), by="Chr") %>%  # 149 markers
                            pmap_dfr(marker_coord_setter) %>% 
                            mutate(Value = if_else(!((Start == 1 | is.na(Start)) | End == Terminal), 9999, 0)) %>% # marker: 9999
                            mutate(Start = if_else(is.na(Start), lag(End) + 1, Start)) %>% 
                            mutate(nominal_spacing = if_else(Value == 9999, 300, End - Start + 1)) %>%
                            mutate(adjusted_start = if_else(Start == 1 | nominal_spacing == 300, Start, Start + 10000000)) %>% 
                            mutate(adjusted_end = if_else(End == Terminal | nominal_spacing == 300, End, End - 10000000)) %>% 
                            mutate(actual_spacing = if_else(Value == 9999, 300, adjusted_end - adjusted_start)) %>%
                            mutate(max_pick = if_else(actual_spacing <= 300 , 0, ceiling((actual_spacing/10000000)))) %>% 
                            # filter(max_pick != 0) %>% 
                            select(-c(min_val, max_val, Init, Terminal, Value)) %>% 
                            # filter(actual_spacing == 300) %>% # 149
                            # filter(actual_spacing > 0 & actual_spacing != 300) %>%
                            view()

