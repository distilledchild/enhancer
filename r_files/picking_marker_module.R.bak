source(file.path(root.dir, '/project_common_code/funcs.R'))

df.2021_N.markers.from.pool <- df.2nd.try.coord.data %>% 
    left_join(df.2021_N.new.marker.pool.data, by = c("Chr" = "CHROM")) %>% 
    filter(adjusted_start < as.numeric(POS) & as.numeric(POS) < adjusted_end) %>% # can be changed with filter(between(POS, adjust_start, adjuste_end)): but causing error if no rows are available
    arrange(Chr, adjusted_start, adjusted_end, POS, desc(genotype_score.x)) %>% 
    select(-(2:4), -c(sample_file, sq, REF, ALT), -c(WLI_IonProton_GT:WMI_xTen_DP)) %>% 
    # mutate(actual_spacing = format(actual_spacing, big.mark=",", scientific=FALSE)) %>% 
    # mutate(POS = format(POS, big.mark=",", scientific=FALSE)) %>% 
    mutate(seq = mapply(marker_seq_fetcher, .$Chr, .$POS - 150, .$POS + 150, species.rat)) %>% 
    mutate(seq_hard = mapply(marker_seq_fetcher, .$Chr, .$POS - 150, .$POS + 150, species.rat, "hard")) %>% 
    mutate(base_151 = str_sub(seq, 151, 151)) %>% 
    mutate(base_151_hard = str_sub(seq_hard, 151, 151)) %>% 
    mutate(before_151_hard = str_sub(seq_hard, end = 150)) %>% 
    mutate(before_151_N_count = str_count(before_151_hard, "N")) %>% 
    mutate(after_151_hard = str_sub(seq_hard, -150)) %>% 
    mutate(after_151_N_count = str_count(after_151_hard, "N")) %>% 
    mutate(seq_length = str_length(seq)) %>% 
    view()

view(df.2021_N.markers.from.pool)
write_csv(df.2021_N.markers.from.pool, "additional_maker_pool_hard15M.csv")


# code for MFEprimer format
result <- read_file("C:/Users/panju/Desktop/playground/byIDE/research/primer3/result.txt") %>% 
as_tibble() %>% 
separate_rows(value, sep = '[\n]', convert=FALSE) %>%
separate(value, c("key", "val"), sep="=", remove=TRUE) %>% 
filter(key == "SEQUENCE_ID"| str_detect(key, "PRIME.*0.*EQUENCE")) %>% 
mutate(key = if_else(str_detect(key,"ID"), ">", "")) %>% 
unite(check, key:val, sep="", remove=TRUE) %>% 
mutate(check = str_trim(check)) %>% 
view()

write_delim(result, "check.txt", delim = "\n", append = FALSE, col_names = FALSE, eol = "\n")
write_delim(result, "C:/Users/panju/Dropbox (UTHSC GGI)/WLIWMIB6Research/1_oxycodone/2021/working files/output_files/2021_R/from_Kurt/check_from_Kurt.txt", delim = "\n", append = FALSE, col_names = FALSE, eol = "\n")

