    filter(str_length(ALT) == 1 & str_length(REF) == 1) %>% 
    mutate(ANN = str_split_n(str_split_n(INFO, ";", 3), "\\|", 2)) %>% 
    mutate(WLI_IonProton_GT = str_split_n(WLI_IonProton, ":", 1)) %>% 
