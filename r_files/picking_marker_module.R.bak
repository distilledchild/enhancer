marker_spacing_filter <- function(...){
    print("what here marker spacign filter")
    current.row.df <- tibble(...) %>% view()
    current.row.df %>% 
        rowwise() %>% str_split_n('\\_', 2) %>% tibble() %>% t() %>% view()
