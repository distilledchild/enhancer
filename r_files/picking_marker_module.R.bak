get_link2 <- function(ID, filter_distance, data_list){

    i = 0
    if(filter_distance == 1){
        i++
        data_list[[i]] <- str_splitp_n(ID, '_', 2)
    }else {
        data_list[[i]] <- str_splitp_n(ID, '_', 2)
    }
    data_list
}


